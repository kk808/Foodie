  },
  "devDependencies": {
    "@foodie/config": "workspace:*",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.3.0",
    "typescript": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
