{
  "name": "@foodie/tokens",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./css": "./dist/tokens.css",
    "./tailwind-theme": {
      "types": "./dist/tailwind-theme.d.ts",
      "default": "./dist/tailwind-theme.js"
    }
  },
  "scripts": {
    "tokens:build": "style-dictionary build --config style-dictionary.config.js",
    "build": "pnpm run tokens:build && tsup src/index.ts src/tailwind-theme.ts --format esm,cjs --dts",
    "prelint": "pnpm run tokens:build",
    "lint": "eslint src",
    "pretypecheck": "pnpm run tokens:build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "style-dictionary": "^4.1.0",
    "tsup": "^8.3.0",
    "typescript": "^6.0.0"
  }
}
